# Application
SECRET_KEY=change-me-with-a-long-random-value
# Optionnel : clé distincte pour les secrets MFA ; sinon SECRET_KEY est utilisée.
# Préserver cette clé lors des mises à niveau et restaurations.
# PAMOLIVE_ENCRYPTION_KEY=une-autre-valeur-aleatoire-longue
DEBUG=true
ALLOWED_HOSTS=pamolive.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://pamolive.example.com
# Set to true in production behind a TLS reverse proxy.
SECURE_SSL_REDIRECT=false
TIME_ZONE=Europe/Brussels
PAMOLIVE_PORT=8001
# false uniquement pour une évaluation HTTP sur un réseau privé ; true derrière HTTPS.
SECURE_COOKIES=false

# PostgreSQL. It may point to a PostgreSQL server on another VM.
# Never use SQLite outside local development.
DATABASE_URL=postgresql://pamolive:change-me@postgres:5432/pamolive

# Used only by the local "postgres" Compose service.
POSTGRES_DB=pamolive
POSTGRES_USER=pamolive
POSTGRES_PASSWORD=change-me

# Préparation PAM : ces listes sont vides par défaut (tout est refusé).
# Une cible doit figurer dans les DEUX listes : hôte:port et réseau IP.
# Ne pas ajouter le sous-réseau entier si une IP /32 ou /128 suffit.
# Aucun relais SSH/RDP n’est encore exposé par cette version alpha.
# PAMOLIVE_TARGET_HOSTS=ssh.example.internal:22,rdp.example.internal:3389
# PAMOLIVE_TARGET_NETWORKS=10.20.30.41/32,10.20.30.42/32
