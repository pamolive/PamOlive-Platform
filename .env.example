# Application
SECRET_KEY=change-me-with-a-long-random-value
# Optionnel : clé distincte pour MFA, secrets de cible et captures PAM ; sinon SECRET_KEY.
# Préserver cette clé lors des mises à niveau et restaurations.
# PAMOLIVE_ENCRYPTION_KEY=une-autre-valeur-aleatoire-longue
DEBUG=true
ALLOWED_HOSTS=pamolive.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://pamolive.example.com
# Set to true in production behind a TLS reverse proxy.
SECURE_SSL_REDIRECT=false
TIME_ZONE=Europe/Brussels
PAMOLIVE_PORT=8001
# false uniquement pour une évaluation HTTP sur un réseau privé ; true derrière HTTPS.
SECURE_COOKIES=false

# PostgreSQL. It may point to a PostgreSQL server on another VM.
# Never use SQLite outside local development.
DATABASE_URL=postgresql://pamolive:change-me@postgres:5432/pamolive

# Used only by the local "postgres" Compose service.
POSTGRES_DB=pamolive
POSTGRES_USER=pamolive
POSTGRES_PASSWORD=change-me

# PAM SSH/RDP-NLA : ces listes sont vides par défaut (tout est refusé).
# Une cible doit figurer dans les DEUX listes : hôte:port et réseau IP.
# Ne pas ajouter le sous-réseau entier si une IP /32 ou /128 suffit.
# RDP : connexion directe avec certificat épinglé ; aucune redirection RDS.
# PAMOLIVE_TARGET_HOSTS=ssh.example.internal:22,rdp.example.internal:3389
# PAMOLIVE_TARGET_NETWORKS=10.20.30.41/32,10.20.30.42/32
# URL publique exacte, sans slash final, si le proxy termine TLS.
# PAMOLIVE_PUBLIC_ORIGIN=https://pamolive.example.com
# Proxy autorisé à ÉCRASER X-Forwarded-For (une IP) et X-Forwarded-Proto.
# Liste vide par défaut : les en-têtes reçus directement sont ignorés.
# PAMOLIVE_TRUSTED_PROXY_NETWORKS=10.20.30.5/32
# Inventaire réseau de confiance, pas une géolocalisation inférée du navigateur.
# PAMOLIVE_NETWORK_CONTEXT=[{"network":"10.20.30.0/24","location":"Bureau Bruxelles","country":"BE"}]

# OIDC multi-fournisseurs (facultatif). Aucun domaine n’est créé par ces variables.
# Origine publique exacte, HTTPS, sans chemin ni slash final. Ne pas déduire du Host reçu.
# PAMOLIVE_OIDC_PUBLIC_ORIGIN=https://pamolive.example.com
# Autoriser les hôtes:ports de discovery, authorize, token et JWKS, sans joker.
# PAMOLIVE_OIDC_HOSTS=idp.example.com:443,login.example.com:443
# Un IdP privé exige aussi ses réseaux précis ; jamais désactiver la vérification TLS.
# PAMOLIVE_OIDC_NETWORKS=10.20.30.10/32
# PAMOLIVE_OIDC_CA_BUNDLE=/run/secrets/oidc-ca.pem
# Voir docs/oidc.md : test complet avant enregistrement, activation et association séparées.

# Connecteurs HTTPS sortants SCIM et TeamViewer, refusés par défaut.
# Ajouter les hôtes précis nécessaires, séparés par des virgules, sans joker.
# PAMOLIVE_CONNECTOR_HOSTS=webapi.teamviewer.com:443,scim.example.com:443
# Un service privé exige aussi ses IP/réseaux précis ; TLS reste obligatoire.
# PAMOLIVE_CONNECTOR_NETWORKS=10.20.30.12/32
# PAMOLIVE_CONNECTOR_CA_BUNDLE=/run/secrets/connectors-ca.pem
# Jetons saisis dans l’interface, chiffrés en base ; jamais dans ces exemples.
# Voir docs/teamviewer.md pour le test avant enregistrement et les limites de collecte.
