# Private synthetic configuration only. Never copy existing installation keys.
# Generate distinct random values locally; do not commit the resulting file.
SECRET_KEY=
PAMOLIVE_ENCRYPTION_KEY=
# Use user pamolive_test, host postgres, database test_pamolive_p1;
# password must equal the synthetic app password file (64 lowercase hex).
DATABASE_URL=
# Bootstrap may leave this empty. Before HTTPS login, inspect the gateway's
# frontend-network peer and set this to that one IPv4 /32 or IPv6 /128 only.
# Revalidate after gateway recreation; never trust the entire Docker subnet.
PAMOLIVE_TRUSTED_PROXY_NETWORKS=
SECURE_COOKIES=true
CSRF_TRUSTED_ORIGINS=https://localhost:18443
