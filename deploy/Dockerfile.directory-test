# Isolated protocol qualification image; never a production deployment image.
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libldap2-dev libsasl2-dev slapd ldap-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock requirements-dev.lock requirements-directory.lock ./
RUN pip install --no-cache-dir -r requirements-dev.lock -r requirements-directory.lock
COPY manage.py pyproject.toml ./
COPY config ./config
COPY platform_core ./platform_core
COPY platform_modules ./platform_modules
COPY deploy ./deploy
COPY tests ./tests
COPY templates ./templates
CMD ["python", "manage.py", "test", "tests.test_directory_adapters", "tests.test_directory_ldap_wire", "--noinput"]
