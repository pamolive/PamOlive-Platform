{
    admin off
    auto_https off
}

:8080 {
    root * /srv

    @home path /
    redir @home /architecture-platform.html 302

    @document path /architecture-platform.html
    handle @document {
        header {
            Content-Type "text/html; charset=utf-8"
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "no-referrer"
            Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
        file_server
    }

    handle {
        respond "Not found" 404
    }
}
