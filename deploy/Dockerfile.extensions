# Use the same application runtime. This does not introduce another service or container.
ARG PAMOLIVE_BASE_IMAGE
FROM ${PAMOLIVE_BASE_IMAGE}
USER root
COPY wheels/ /tmp/pamolive-extension-wheels/
COPY requirements.lock /tmp/pamolive-extensions.lock
COPY catalog.json /etc/pamolive/extensions/catalog.json
COPY public-keys.json /etc/pamolive/extensions/public-keys.json
ENV PAMOLIVE_EXTENSION_CATALOG=/etc/pamolive/extensions/catalog.json
ENV PAMOLIVE_EXTENSION_TRUST_KEYS_FILE=/etc/pamolive/extensions/public-keys.json
RUN python -m platform_core.extensions.release verify-catalog-wheels --catalog /etc/pamolive/extensions/catalog.json --wheelhouse /tmp/pamolive-extension-wheels --public-keys /etc/pamolive/extensions/public-keys.json --requirements-lock /tmp/pamolive-extensions.lock && pip install --no-index --no-deps --no-compile --disable-pip-version-check --no-cache-dir --require-hashes --find-links /tmp/pamolive-extension-wheels -r /tmp/pamolive-extensions.lock && pip check && DATABASE_URL=sqlite:///:memory: python manage.py makemigrations --check --dry-run && DATABASE_URL=sqlite:///:memory: python manage.py pamolive_extensions verify && rm -r /tmp/pamolive-extension-wheels /tmp/pamolive-extensions.lock
# Runtime, UID separation, healthcheck, read-only operation and single port are inherited.
