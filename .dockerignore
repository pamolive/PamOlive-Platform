**/*.secret
**/.bootstrap-admin
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tgz
**/*.tar
**/*.tar.gz
**/*.zip
**/*.dump
**/*.backup
**/*.pgdump
**/*.sqlite3
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/*.whl
**/*.egg-info
**/build
**/dist
