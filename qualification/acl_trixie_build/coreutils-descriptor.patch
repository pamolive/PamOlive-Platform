diff --git a/lib/acl-target.h b/lib/acl-target.h
new file mode 100644
--- /dev/null
+++ b/lib/acl-target.h
@@ -0,0 +1,98 @@
+/* Descriptor helpers for the Linux ACL setter.  */
+#ifndef COREUTILS_ACL_TARGET_H
+#define COREUTILS_ACL_TARGET_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static inline void
+acl_close_target (int fd)
+{
+  int error_code = errno;
+  close (fd);
+  errno = error_code;
+}
+
+static inline int
+acl_validate_target (int fd, struct stat const *expected)
+{
+  if (fd < 0)
+    return -1;
+  struct stat target;
+  if (fstat (fd, &target) != 0)
+    {
+      acl_close_target (fd);
+      return -1;
+    }
+  if (S_ISLNK (target.st_mode))
+    errno = ELOOP;
+  else if (expected && (target.st_dev != expected->st_dev
+                        || target.st_ino != expected->st_ino
+                        || (target.st_mode & S_IFMT)
+                           != (expected->st_mode & S_IFMT)))
+    errno = ESTALE;
+  else
+    return fd;
+
+  acl_close_target (fd);
+  return -1;
+}
+
+/* If the caller already observed the target, allow its intentional parent
+   paths and verify the opened inode.  For callers without that information,
+   anchor each parent directory and decline symbolic links in the lookup.  */
+static inline int
+acl_open_target (int dirfd, char const *name, struct stat const *expected)
+{
+  char path[PATH_MAX];
+  size_t len = strnlen (name, sizeof path);
+  if (len == 0 || len == sizeof path)
+    {
+      errno = len ? ENAMETOOLONG : ENOENT;
+      return -1;
+    }
+  memcpy (path, name, len + 1);
+  int final_flags = name[len - 1] == '/' ? O_DIRECTORY : 0;
+  while (len > 1 && path[len - 1] == '/')
+    path[--len] = '\0';
+
+  int flags = O_PATH | O_CLOEXEC | O_NOFOLLOW;
+  if (expected)
+    {
+      /* A caller-selected referent is valid only if this descriptor identifies
+         that exact object.  This preserves intentional link and slash use.  */
+      int fd = openat (dirfd, path, (flags & ~O_NOFOLLOW) | final_flags);
+      return acl_validate_target (fd, expected);
+    }
+
+  int parent = openat (dirfd, path[0] == '/' ? "/" : ".",
+                       flags | O_DIRECTORY);
+  if (parent < 0)
+    return -1;
+  for (char *component = path, *end; ; component = end + 1)
+    {
+      while (*component == '/')
+        component++;
+      end = strchr (component, '/');
+      if (!end)
+        {
+          if (!*component)
+            return parent;
+          int fd = openat (parent, component, flags | final_flags);
+          acl_close_target (parent);
+          return acl_validate_target (fd, NULL);
+        }
+      *end = '\0';
+      int child = openat (parent, component, flags | O_DIRECTORY);
+      acl_close_target (parent);
+      if (child < 0)
+        return -1;
+      parent = child;
+    }
+}
+
+#endif
