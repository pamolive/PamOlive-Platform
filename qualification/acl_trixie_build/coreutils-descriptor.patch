+int
+set_permissions (struct permission_context *ctx, const char *name, int desc)
+{
+#if defined __linux__ && USE_ACL
+  if (desc < 0)
+    {
+      desc = acl_open_target (AT_FDCWD, name, NULL);
+      if (desc < 0)
+        return -1;
+      int ret = set_permissions_for_target (ctx, name, desc);
+      acl_close_target (desc);
+      return ret;
