+/* Keep the chmod fallback bound to the descriptor used for the ACL.  */
+static int
+chmod_acl_target (const char *name, int desc, mode_t mode)
+{
+#if defined __linux__ && USE_ACL
+  (void) name;
+  int ret = fchmod (desc, mode);
+  if (ret == 0 || errno != EBADF)
+    return ret;
+  if (fchmodat (desc, "", mode, AT_EMPTY_PATH) == 0)
+    return 0;
+  if (errno != EINVAL && errno != ENOSYS && errno != EOPNOTSUPP
+      && errno != EBADF && errno != ENOENT)
+    return -1;
+
+  /* Older kernels need the procfs reference for O_PATH descriptors.  */
+  char reference[64];
+  snprintf (reference, sizeof reference, "/proc/self/fd/%d", desc);
+  return chmod (reference, mode);
+#else
+  return chmod_or_fchmod (name, desc, mode);
+#endif
+}
