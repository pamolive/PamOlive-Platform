diff --git a/src/tar-acl-descriptor.h b/src/tar-acl-descriptor.h
new file mode 100644
--- /dev/null
+++ b/src/tar-acl-descriptor.h
@@ -0,0 +1,92 @@
+/* Internal helper for the Debian Linux descriptor-based tar ACL build. */
+#ifndef TAR_ACL_DESCRIPTOR_H
+#define TAR_ACL_DESCRIPTOR_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static bool
+tar_acl_same_inode (struct stat const *left, struct stat const *right)
+{
+  return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
+}
+
+static void
+tar_acl_close (int fd)
+{
+  int saved_errno = errno;
+  close (fd);
+  errno = saved_errno;
+}
+
+/* Use the content descriptor when available.  Deferred metadata calls
+   walk from tar's selected directory without following symbolic links. */
+static int
+tar_acl_descriptor (int dirfd, char const *name, int fd)
+{
+  struct stat st;
+  if (fd >= 0)
+    return fcntl (fd, F_DUPFD_CLOEXEC, 3);
+
+  size_t length = strnlen (name, PATH_MAX);
+  if (length == 0 || length == PATH_MAX)
+    {
+      errno = length == 0 ? ENOENT : ENAMETOOLONG;
+      return -1;
+    }
+
+  int flags = O_PATH | O_NOFOLLOW | O_CLOEXEC;
+  int current;
+  if (*name == '/' || dirfd == AT_FDCWD)
+    current = open (*name == '/' ? "/" : ".", flags | O_DIRECTORY);
+  else
+    current = fcntl (dirfd, F_DUPFD_CLOEXEC, 3);
+  if (current < 0)
+    return -1;
+
+  while (*name != '\0')
+    {
+      char component[NAME_MAX + 1];
+      size_t bytes = strcspn (name, "/");
+      if (bytes > NAME_MAX)
+        {
+          errno = ENAMETOOLONG;
+          tar_acl_close (current);
+          return -1;
+        }
+      if (bytes != 0)
+        {
+          memcpy (component, name, bytes);
+          component[bytes] = '\0';
+          int next = openat (current, component,
+                             flags | (name[bytes] ? O_DIRECTORY : 0));
+          tar_acl_close (current);
+          if (next < 0)
+            return -1;
+          current = next;
+          name += bytes;
+        }
+      if (*name == '/')
+        name++;
+    }
+
+  if (fstat (current, &st) == -1)
+    {
+      tar_acl_close (current);
+      return -1;
+    }
+  if (S_ISLNK (st.st_mode))
+    {
+      errno = ELOOP;
+      tar_acl_close (current);
+      return -1;
+    }
+  return current;
+}
+
+#endif
